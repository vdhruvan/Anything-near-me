# Library Finder Configuration
PORT=3001

# Place provider to use: 'overpass' (OpenStreetMap - no key needed), 'google' (Google Places API), or 'mock'
PLACES_PROVIDER=overpass

# Google Places API Key (optional - needed only if PLACES_PROVIDER is set to 'google')
PLACES_API_KEY=your_api_key_here

# Default search radius in kilometers
DEFAULT_SEARCH_RADIUS_KM=5

# Minimum results before expanding search radius (e.g. 5km -> 10km -> 25km)
MIN_RESULTS_THRESHOLD=3
